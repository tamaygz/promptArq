{
  "name": "Nord",
  "version": "1.0",
  "colors": {
    "background": "#2E3440",
    "controlBackground": "#3B4252",
    "inputBackground": "#434C5E",
    "headerBackground": "#3B4252",
    "foreground": "#ECEFF4",
    "secondaryForeground": "#D8DEE9",
    "accent": "#88C0D0",
    "border": "#4C566A",
    "selection": "#88C0D0"
  },
  "fonts": {
    "default": {
      "family": "Segoe UI",
      "size": 10,
      "style": "Regular"
    },
    "heading": {
      "family": "Segoe UI",
      "size": 14,
      "style": "Bold"
    },
    "searchBox": {
      "family": "Segoe UI",
      "size": 16,
      "style": "Regular"
    }
  },
  "window": {
    "opacity": 0.97,
    "cornerRadius": 15,
    "titleBarColor": "#002E3440",
    "borderColor": "#002E3440"
  },
  "controls": {
    "button": {
      "background": "#434C5E",
      "foreground": "#ECEFF4",
      "hoverBackground": "#88C0D0"
    },
    "listBox": {
      "background": "#3B4252",
      "foreground": "#ECEFF4",
      "selectedBackground": "#88C0D0",
      "selectedForeground": "#2E3440"
    },
    "textBox": {
      "background": "#434C5E",
      "foreground": "#ECEFF4"
    }
  }
}

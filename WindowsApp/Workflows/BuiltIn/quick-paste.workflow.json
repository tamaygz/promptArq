{
  "id": "quick-paste",
  "name": "Quick Paste",
  "description": "Search for a prompt and paste its content to the active window",
  "icon": "📝",
  "entryNodeId": "search",
  "nodes": [
    {
      "id": "search",
      "nodeType": "SearchPromptsNode",
      "allowBackNavigation": true
    },
    {
      "id": "selectAction",
      "nodeType": "SelectActionNode",
      "allowBackNavigation": true
    },
    {
      "id": "checkAction",
      "nodeType": "ConditionalNode",
      "configuration": {
        "condition": "selectedaction"
      }
    },
    {
      "id": "checkLLM",
      "nodeType": "ConditionalNode",
      "configuration": {
        "condition": "action == 'PasteWithLLM'"
      }
    },
    {
      "id": "executeLLM",
      "nodeType": "ExecuteLLMNode"
    },
        {
      "id": "copy",
      "nodeType": "CopyToClipboardNode"
    },
    {
      "id": "paste",
      "nodeType": "PasteToActiveWindowNode"
    },
    {
      "id": "notify",
      "nodeType": "ShowNotificationNode"
    },
    {
      "id": "recordHistory",
      "nodeType": "RecordHistoryNode"
    },
    {
      "id": "close",
      "nodeType": "CloseCommandPaletteNode"
    }
  ],
  "connections": {
    "search": "selectAction",
    "selectAction": "checkAction",
    "checkAction": "copy",

    "checkLLM": "paste",
    "executeLLM": "paste",
    "copy": "recordHistory",
    "paste": "recordHistory",
    "recordHistory": "notify",
    "notify": "close"
  },
  "branches": {
    "checkAction": {
      "Copy": "copy",
      "Paste": "paste",
      "checkLLM": "checkLLM"
    },
    "checkLLM": {
      "true": "executeLLM",
      "false": "paste"
    },
    "selectAction": {
      "PasteDirectly": "paste",
      "PasteWithLLM": "checkLLM"
    }
  },
  "metadata": {
    "author": "PromptArq Team",
    "version": "1.0.0",
    "tags": [
      "clipboard",
      "paste",
      "quick-action"
    ],
    "requiredServices": [
      "IClipboardService"
    ]
  }
}